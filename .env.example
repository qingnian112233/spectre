# ===== SPECTRE · 多智能体框架 配置示例(复制为 .env 并填自己的值) =====
DEEPSEEK_API_KEY=sk-YOUR_API_KEY_HERE
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
# 主备用双通道(可选, 主通道故障自动切换)
DEEPSEEK_API_KEY_BK=
DEEPSEEK_API_BK=https://api.deepseek.com/v1
DEEPSEEK_BOT_TOKEN=YOUR_BOT_TOKEN_HERE
# 可选: 情报/多模态等第三方 key
FOFA_API_KEY=
FOFA_EMAIL=
QWEN_API_KEY=
# 可选: 动态代理池(留空=直连)
PROXY_DYNAMIC_URL=
